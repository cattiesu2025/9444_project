#!/bin/bash
#PBS -N agw-baseline
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1:gpu_model=L40S
#PBS -l walltime=02:00:00
#PBS -j oe

# AGW/CAJ counterpart of train.pbs (same environment and evidence layout).
# Requires checkpoints/resnet50-19c8e357.pth: run scripts/prepare_pretrained.py --model resnet50
# on the login node first. Long runs are split across jobs with RESUME=1.
set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit qsub from the project directory}"
: "${RUN_ID:?Pass -v EXPERIMENT=AGW,RUN_ID=dev_AGW_seed17_pilot,MAX_STEPS=20}"
if [[ -n "${PMT_ENV_SETUP:-}" ]]; then
    source "$PMT_ENV_SETUP"
fi
PMT_PYTHON="${PMT_PYTHON:-$PWD/.venv/bin/python}"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export PYTHONUNBUFFERED=1
export CUBLAS_WORKSPACE_CONFIG=:4096:8

JOB_EVIDENCE="$PWD/artifacts/results/katana_jobs/${PBS_JOBID:?}"
mkdir -p "$JOB_EVIDENCE"
hostname > "$JOB_EVIDENCE/hostname.txt"
nvidia-smi > "$JOB_EVIDENCE/nvidia-smi.txt"
"$PMT_PYTHON" -c 'import importlib.metadata as m; print("\n".join(sorted(d.metadata["Name"] + "==" + d.version for d in m.distributions())))' > "$JOB_EVIDENCE/requirements-lock.txt"
"$PMT_PYTHON" -c 'import torch; assert torch.cuda.is_available(), "CUDA PyTorch/GPU unavailable"; print(torch.__version__, torch.version.cuda, torch.cuda.get_device_name(0))'

ARGS=(--experiment "${EXPERIMENT:?AGW, CAJ or CAJ_fix}" --run-id "$RUN_ID" --device cuda --num-workers 4 --seed "${SEED:-17}")
if [[ -n "${SYSU_MM01_ROOT:-}" ]]; then ARGS+=(--root "$SYSU_MM01_ROOT"); fi
if [[ -n "${PMT_PRETRAINED:-}" ]]; then ARGS+=(--pretrained "$PMT_PRETRAINED"); fi
if [[ "${RESUME:-0}" == 1 ]]; then ARGS+=(--resume "checkpoints/$RUN_ID/last.pt"); fi
# MAX_STEPS=0 runs all remaining epochs; otherwise stop after that many batches (resumable).
if [[ "${MAX_STEPS:-20}" != 0 ]]; then ARGS+=(--max-steps "${MAX_STEPS:-20}"); fi
"$PMT_PYTHON" -m src.train_agw "${ARGS[@]}"

if [[ "${MAX_STEPS:-20}" == 0 && "${EXPORT_ON_COMPLETE:-1}" == 1 ]]; then
    "$PMT_PYTHON" -m src.export_features --checkpoint "checkpoints/$RUN_ID/last.pt" --modality ir --output "artifacts/results/$RUN_ID/query_val.npz" --device cuda --batch-size 64
    "$PMT_PYTHON" -m src.export_features --checkpoint "checkpoints/$RUN_ID/last.pt" --modality rgb --output "artifacts/results/$RUN_ID/gallery_pool_val.npz" --device cuda --batch-size 64
fi
if [[ "${PILOT_EXPORT:-0}" == 1 ]]; then
    "$PMT_PYTHON" -m src.export_features --checkpoint "checkpoints/$RUN_ID/last.pt" --modality ir --output "artifacts/results/$RUN_ID/pilot/query_val.npz" --device cuda --batch-size 64
    "$PMT_PYTHON" -m src.export_features --checkpoint "checkpoints/$RUN_ID/last.pt" --modality rgb --output "artifacts/results/$RUN_ID/pilot/gallery_pool_val.npz" --device cuda --batch-size 64
fi
